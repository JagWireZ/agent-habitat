# Default project config for `habitat run`, showing every recognized key
# with its default value. This file is optional -- a missing config file
# behaves exactly like every key below being left at its default.
#
# Format notes:
#   - This is a strict, hand-rolled subset of YAML: no flow style
#     (`{ }` / `[ ]`), no multi-line scalars, no anchors. Plain `key: value`
#     and `- item` list entries only. 2-space indentation for nested keys.
#   - An unrecognized top-level or nested key is a hard load error, not a
#     silently ignored typo.
#   - Copy this file to sandbox.yaml (or pass --config <path>) and trim it
#     to just the keys you want to override.

# Extra filename patterns to block from entering the sandboxed workspace,
# on top of the built-in blocklist. Glob-style patterns.
# Default: empty list.
blocklist_additions:
  - "*.mysecret"
  - local.creds

# Whether the session's git history is real or synthetic.
git_history:
  # Default: false -- seed a brand-new, synthetic repo with no real
  # history. Setting this to true shares the real .git, read-only, but
  # requires a complete approval below (all three fields non-empty) or
  # resolution fails hard.
  enabled: false
  # Required (non-empty) when enabled: true. Who reviewed and approved
  # sharing real git history with the agent.
  approved_by: Jane Doe
  # Required (non-empty) when enabled: true. When the approval was given.
  approved_date: 2026-09-14
  # Required (non-empty) when enabled: true. Why real history is needed
  # (e.g. "legacy blame needed").
  reason: legacy blame needed

# Secrets scanning, run against the workspace before it's handed to the
# agent.
secrets_scan:
  # Filename-based blocklist mechanism. Default: enabled.
  filenames: enabled
  # Betterleaks-based content scan. Default: enabled.
  content: enabled
  # Optional path to a project-specific Betterleaks rules file. Its rules
  # are additive to the bundled baseline, never a full replacement.
  # Default: none (baseline rules only).
  content_rules_path: "./custom-betterleaks.toml"

# CPU/memory caps applied to the session's microVM at launch. There is no
# separate disk-limit knob -- disk is capped by the fixed build-time size
# of the session's disk image.
resource_limits:
  # Number of vCPUs, as a positive number (fractional allowed, e.g. 1.5).
  # Default: 2.
  cpus: 2
  # Memory cap in megabytes, as a positive integer. Default: 2048.
  memory_mb: 2048

# Extra hostnames/patterns to allow through the egress firewall, on top of
# the built-in allowlist.
# Default: empty list.
egress_allowlist_additions:
  - internal.registry.example
  - "*.corp.example"
  # Claude Code needs platform.claude.com for auth/session traffic,
  # beyond the default-allowed api.anthropic.com.
  - platform.claude.com
  # Codex needs these for login (auth.openai.com) and cloud config/API
  # traffic (chatgpt.com), beyond the default-allowed api.openai.com.
  - auth.openai.com
  - chatgpt.com

# Audit log verbosity. Default: enabled. This only controls a handful of
# suppressible, non-invariant-critical log entries -- it never disables the
# boundary audit trail itself.
audit: enabled

# Whether `habitat run` may seed a missing agent auth/config file under
# ~/.habitat/agents/<agent>/ (the staging area actually copied into the
# guest -- see docs/decisions/0011-agent-state-copy-in-out.md) from your
# real dotfiles already on this host: ~/.claude.json,
# ~/.claude/.credentials.json, ~/.claude/settings.json,
# ~/.codex/auth.json, etc.
#
# Default: disabled. With this off, habitat never reads your real
# dotfiles at all -- only ~/.habitat/agents/<agent>/ is ever used. A
# staging file that doesn't exist yet is simply left missing; the agent
# creates it fresh in the guest's home directory the first time it needs
# it (a first login, a first-run settings file), exactly as it would on a
# brand-new machine. At the end of the session, auth files (OAuth
# tokens, etc.) are copied back out to ~/.habitat/agents/<agent>/, so the
# *next* run already has them staged even with this still disabled.
#
# Set to enabled to seed any staging file missing on first use from the
# matching real dotfile instead of leaving the agent to create its own --
# useful the first time you adopt habitat, so an agent you already use
# directly on this machine doesn't need to log in or reconfigure again
# inside the guest. This also seeds config entries (settings.json,
# CLAUDE.md, custom commands/skills, etc.), which can carry host-specific
# hooks, MCP servers, or apiKeyHelper scripts into every future guest
# session -- an explicit, informed trade-off, which is why it defaults to
# off.
agent_host_files: disabled
